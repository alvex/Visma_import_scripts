import pandas as pd
import pyautogui
import time
from pathlib import Path
from datetime import datetime

pyautogui.PAUSE = 0.2

# ─────────────────────────────────────────────────────────────────────────────
# INSTÄLLNINGAR FÖR ER VISMA-SKÄRM (Kundbokning)
# ─────────────────────────────────────────────────────────────────────────────
# Tangent som SPARAR/REGISTRERAR fakturan när alla fält är ifyllda.
#   - En tangent:  SAVE_KEY = "f2"   (eller "f12", "enter" ...)
#   - Kombination: SAVE_KEY = ("ctrl", "enter")   eller   ("alt", "s")
#
# OBS om sparatangenten är "+":
#   "+"   = plus på VANLIGA tangentbordet (övre sifferraden)
#   "add" = plus på NUMERISKA knappsatsen (numpad +)  <- vanligast i Visma/SPCS
# Funkar inte "+" när du testar? Byt då till "add".
SAVE_KEY = "+"

# Sekunder att vänta efter spara, så Visma hinner ladda om för nästa faktura.
SAVE_DELAY = 1.5

# Antal Tab för att flytta markören MELLAN fälten.
# Fältföljd på skärmen: KundID -> [Kundnamn] -> Fakturanr -> Fakturadatum
#                       -> Förfallodatum -> Belopp
#
# Fakturanr och Förfallodatum skapas AUTOMATISKT av Visma och ska bara
# tabbas förbi (inget skrivs i dem).
TABS_AFTER_KUNDID = 1        # KundID -> Fakturanr (Kundnamn auto-hoppas)
TABS_SKIP_FAKTURANR = 1      # Fakturanr (auto) -> Fakturadatum
TABS_AFTER_FAKTURADATUM = 1  # Fakturadatum -> Förfallodatum
TABS_SKIP_FORFALLODATUM = 1  # Förfallodatum (auto) -> Belopp

# Testgräns: hur många fakturor som körs.
#   1 = registrera BARA första fakturan (säkert test)
#   0 = kör ALLA fakturor i filen
# Sätt till 0 först när du verifierat att 1 testfaktura blev rätt i Visma.
TEST_LIMIT = 1
# ─────────────────────────────────────────────────────────────────────────────


def format_date(value):
    """
    Converts Excel/date/string to YY-MM-DD format used by Visma Compact.
    Example: 2026-05-15 -> 26-05-15
    """
    if pd.isna(value):
        return ""

    if isinstance(value, datetime):
        return value.strftime("%y-%m-%d")

    value = str(value).strip()

    # Try normal date parsing
    try:
        dt = pd.to_datetime(value)
        return dt.strftime("%y-%m-%d")
    except Exception:
        return value


def format_amount(value):
    """
    Converts amount to Swedish decimal format if needed.
    Example: 1949.00 -> 1949,00
    """
    if pd.isna(value):
        return "0,00"

    try:
        amount = float(value)
        return f"{amount:.2f}".replace(".", ",")
    except Exception:
        return str(value).replace(".", ",")


def write_text(text):
    pyautogui.write(str(text), interval=0.01)


def press_tab(times=1):
    for _ in range(times):
        pyautogui.press("tab")


def save_record():
    """
    Sparar fakturan med tangenten som är inställd i SAVE_KEY.
    Stödjer både en enstaka tangent ("f2") och en kombination ("ctrl", "enter").
    """
    if isinstance(SAVE_KEY, (tuple, list)):
        pyautogui.hotkey(*SAVE_KEY)
    else:
        pyautogui.press(SAVE_KEY)
    time.sleep(SAVE_DELAY)


def register_invoice(row):
    """
    Tab-flöde anpassat efter er Kundbokning-skärm i Visma Compact:

        KundID (personnr)  -> skriv      --Tab-->  (Kundnamn auto-hoppas)
        Fakturanr          -> SKRIVS EJ  --Tab-->  (skapas automatiskt)
        Fakturadatum       -> skriv      --Tab-->
        Förfallodatum      -> SKRIVS EJ  --Tab-->  (skapas automatiskt)
        Belopp             -> skriv      --Tab-->  (lämnar fältet före spara)
        => spara med SAVE_KEY

    Markören måste stå i KundID-fältet när detta körs.
    """

    kund_id = str(row["KundID"]).strip()
    fakturadatum = format_date(row["Fakturadatum"])
    belopp = format_amount(row["Belopp"])

    # KundID skrivs in, sedan Tab förbi (auto)Kundnamn fram till Fakturanr.
    write_text(kund_id)
    press_tab(TABS_AFTER_KUNDID)

    # Fakturanr skapas automatiskt -> skriv inget, tabba bara förbi.
    press_tab(TABS_SKIP_FAKTURANR)

    # Fakturadatum skrivs in, sedan Tab till Förfallodatum.
    write_text(fakturadatum)
    press_tab(TABS_AFTER_FAKTURADATUM)

    # Förfallodatum skapas automatiskt -> skriv inget, tabba bara förbi.
    press_tab(TABS_SKIP_FORFALLODATUM)

    # Belopp skrivs in sist, Tab lämnar fältet så Visma bekräftar värdet.
    write_text(belopp)
    press_tab()
    press_tab()
    press_tab()
    press_tab()
    press_tab()
    SAVE_KEY = "add"
    save_record()


def resolve_excel_path(excel_path):
    """
    Resolves the Excel path even if the user forgot the extension or
    added trailing spaces/quotes. Returns a Path that exists, or None.
    """
    excel_path = excel_path.strip().strip('"').strip("'").strip()
    file_path = Path(excel_path)

    if file_path.exists():
        return file_path

    # User probably left out the extension (e.g. ...kundfakturor_2026-05-18_02)
    if file_path.suffix.lower() not in (".xlsx", ".xls"):
        for ext in (".xlsx", ".xls"):
            candidate = file_path.with_name(file_path.name + ext)
            if candidate.exists():
                return candidate

    return None


def main():
    excel_path = input("Visma import v.2.1. - Ange sökväg till Excel-filen: ")
    file_path = resolve_excel_path(excel_path)

    if file_path is None:
        print(f"Filen hittades inte: {excel_path.strip().strip(chr(34))}")
        print("Kontrollera sökvägen. Tips: filändelsen .xlsx behövs inte längre.")
        return

    df = pd.read_excel(file_path)

    # Kolumn-alias: filen har ofta "Personnummer" i stället för "KundID".
    # Mappa det till KundID så att Kundbokningen får personnumret som kundidentitet.
    column_aliases = {
        "KundID": ["KundID", "Personnummer", "Kundnummer"],
    }
    for target, candidates in column_aliases.items():
        if target not in df.columns:
            for cand in candidates:
                if cand in df.columns:
                    df = df.rename(columns={cand: target})
                    break

    # Endast fält som faktiskt skrivs in i Visma krävs.
    # Fakturanr och Förfallodatum skapas automatiskt av Visma och
    # behövs alltså inte i Excel-filen.
    required_columns = [
        "KundID",
        "Fakturadatum",
        "Belopp",
    ]

    missing = [col for col in required_columns if col not in df.columns]

    if missing:
        print("Excel-filen saknar dessa kolumner:")
        for col in missing:
            print(f"- {col}")
        return

    if TEST_LIMIT and TEST_LIMIT > 0:
        df = df.head(TEST_LIMIT)
        print(f"TESTLÄGE: kör endast {len(df)} av fakturorna "
              f"(ändra TEST_LIMIT = 0 i scriptet för att köra alla).")

    print(f"Hittade {len(df)} fakturor.")
    print("Öppna Visma Compact → Kundreskontra → Kundbokning.")
    print("Klicka i första fältet där KundID ska fyllas i.")
    input("Tryck Enter här när du är redo...")

    print("Startar om 5 sekunder...")
    time.sleep(5)

    log_rows = []

    for index, row in df.iterrows():
        fakturanr = row.get("Fakturanr", "")

        try:
            print(f"Registrerar faktura {fakturanr}...")
            register_invoice(row)

            log_rows.append({
                "Rad": index + 2,
                "Fakturanr": fakturanr,
                "Status": "OK",
                "Fel": ""
            })

            time.sleep(0.5)

        except Exception as e:
            log_rows.append({
                "Rad": index + 2,
                "Fakturanr": fakturanr,
                "Status": "FEL",
                "Fel": str(e)
            })

            print(f"Fel på faktura {fakturanr}: {e}")
            break

    log_df = pd.DataFrame(log_rows)
    log_file = file_path.parent / f"visma_import_logg_{datetime.now().strftime('%Y%m%d_%H%M%S')}.xlsx"
    log_df.to_excel(log_file, index=False)

    print(f"Klar. Logg sparad här: {log_file}")


if __name__ == "__main__":
    main()
